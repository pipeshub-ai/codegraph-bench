# Copy to bench/b3/b3.env (git-ignored). The PipesHub stack B3 brings up with docker compose (project cg-b3).
# MCP_SCOPES as measured; newer PipesHub versions also need code:read here.
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3940
WEB_CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_EGRESS_IPS=
PIPESHUB_BLOCK_PRIVATE_ADDRESSES=
IMAGE_TAG=slim
SECRET_KEY=<generate: openssl rand -hex 24>
FRONTEND_PUBLIC_URL=
NEO4J_PASSWORD=<generate: openssl rand -hex 24>
ARANGO_PASSWORD=<generate: openssl rand -hex 24>
REDIS_PASSWORD=<generate: openssl rand -hex 24>
MONGO_USERNAME=<generate: openssl rand -hex 24>
MONGO_PASSWORD=<generate: openssl rand -hex 24>
QDRANT_API_KEY=<generate: openssl rand -hex 24>
DATA_STORE=neo4j
KV_STORE_TYPE=redis
MESSAGE_BROKER=redis
COMPOSE_PROFILES=graph-neo4j
REDIS_STREAMS_MAXLEN=500000
FAIR_SCHEDULING_LANE_COUNT=8
MCP_SCOPES=openid,profile,email,offline_access,semantic:write,conversation:write,conversation:chat,kb:read,team:read,user:read,usergroup:read,config:read,agent:read,agent:execute,connector:read
INDEXING_UVICORN_WORKERS=1
PARSING_UVICORN_WORKERS=1
DOCLING_UVICORN_WORKERS=1
LOCAL_DOCLING_PARSE_WORKERS=1
PDF_OCR_DETECTION_WORKERS=1
PIPESHUB_AGENT_TRANSPORT=langchain
PIPESHUB_ACCESSIBLE_RECORDS_CACHE=
PIPESHUB_ACCESSIBLE_RECORDS_CACHE_TTL=300
PIPESHUB_SIGNED_URL_CACHE_SECONDS=0
PIPESHUB_AGENT_MAX_TURN_OUTPUT_CHARS=
CONNECTOR_SYNC_MAX_CONCURRENT=8
CONNECTOR_SYNC_DELETE_STOP_WAIT_SEC=15
EMBEDDING_SERVER_URL=http://localhost:8002
LOG_MAX_SIZE=20m
LOG_MAX_FILE=15
INDEXING_SPLIT_LEASE_POOLS=
GOVERNOR_HEAVY_PARSE_SLOTS_PER_CPU=
GOVERNOR_LIGHT_PARSE_SLOTS_PER_CPU=
GOVERNOR_LIGHT_PARSE_MAX=
PARSE_MAX_ORG_SHARE=
GOVERNOR_INDEX_HEADROOM=
GOVERNOR_INDEX_MAX=
GOVERNOR_INDEX_HEAVY_WORKING_SET_GB=
GOVERNOR_INDEX_LIGHT_WORKING_SET_GB=
GOVERNOR_HEAVY_PARSE_WORKING_SET_GB=
MAX_TABLE_ROWS_FOR_LLM=1000
EXCEL_MAX_TABLE_ROWS_TO_INDEX=20000
EXCEL_HEADER_GENERATION_SAMPLE_SCAN_LIMIT=500
CODE_FILE_MAX_SIZE_MB=
PARSE_POOL_WORKERS=
SAML_SP_ENTITY_ID=
COMPOSE_PROJECT_NAME=cg-b3
